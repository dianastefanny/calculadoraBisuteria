# Forzar la exclusión del entorno de dependencias de Node

node_modules/

# Excluir binarios nativos compilados y temporales

ios/
android/
.expo/
dist/
web-build/
build/
.gradle/

# Archivos de bloqueo de paquetes altamente pesados en texto plano

package-lock.json
yarn.lock
pnpm-lock.yaml

# Archivos temporales y de depuración del empaquetador Metro

.metro-health-check*
_.tsbuildinfo
npm-debug._
yarn-debug.*

# Archivos de credenciales locales y llaves sensibles

.env*
*.jks
*.p12
*.pem
*.key
